# Copy to .env and fill in. Never commit the real .env file.

# Optional but recommended — full-length legal MP3 downloads
# Free key: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# Optional — YouTube search/metadata fallback
# Free key: https://console.cloud.google.com/ (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Download tuning
DL_CONCURRENCY=6
DL_TIMEOUT=20000
