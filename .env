# ═══════════════════════════════════════════════════════════════════
#  MAIS MDX BOT — MASTER ENVIRONMENT FILE (multi-session ready)
#  Owner identity is resolved per paired session at runtime — no
#  OWNER_NUMBER / OWNER_NAME needed. Fill the placeholders, then
#  paste everything into Railway: Service → Variables → Raw Editor.
# ═══════════════════════════════════════════════════════════════════

# ── CORE ───────────────────────────────────────────────────────────
BOT_NAME=MAIS MDX
PREFIX=.
MARK_ONLINE=1
LOG_DEDUP=1
NODE_ENV=production

# ── BUILD / DEPLOY (forces clean builds so fixes always apply) ────
NO_CACHE=1
UV_THREADPOOL_SIZE=16

# ── BOT BEHAVIOUR (sane defaults) ──────────────────────────────────
BUTTON_MODE=auto
STICKER_PACK_NAME=MAIS
STICKER_AUTHOR_NAME=MAIS Bot
MOVIE_MAX_MB=500
AUTO_DL_MAX_MB=100
MAX_DOWNLOAD_BYTES=104857600
MAX_INSTANCES=50
MAX_AUTO_RESTARTS=8

# ── WEB ADMIN PANEL (login for the pairing dashboard) ─────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<choose-a-password>

# ── OPTIONAL API KEYS (leave empty = feature stays off) ───────────
# AI / media
GEMINI_KEY=
ZERO_API_KEY=
YOUTUBE_API_KEY=
ASSEMBLYAI_KEY=
DEEPGRAM_KEY=
MODELSLAB_KEY=
REPLICATE_TOKEN=
MYNETNAIJA_API=
PRINCE_API_KEY=
GIFTED_KEY=
JAMENDO_CLIENT_ID=

# Phone number lookup (used by .num lookup commands)
NUMVERIFY_KEY=
ABSTRACT_PHONE_KEY=

# Telegram integration (log channel / notify bot)
TELEGRAM_BOT_TOKEN=
TG_BOT_TOKEN=
TG_CHANNEL_1=
TG_GROUP_1=

# ── AUTO-DETECTED (do NOT set these manually) ─────────────────────
# PORT, REPO_SLUG, REPO_BRANCH, RAILWAY_* are injected by Railway.
# Replit/Render/Heroku/Vercel flags are detected at runtime.
